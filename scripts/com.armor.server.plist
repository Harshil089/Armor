<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.armor.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/harshilbuch/Armor/.venv/bin/uvicorn</string>
        <string>armor.api.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8001</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/harshilbuch/Armor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- ponytail: this is the whole point of this file — without it,
             any restart (crash, reboot, launchd itself) silently reverts
             to the stub path (decision="allow" for every request, zero
             real inspection). Every calibration/bandit/streaming-inspection
             work this session only matters while this flag is set. -->
        <key>ARMOR_USE_BASE_MODEL</key>
        <string>1</string>
        <key>ARMOR_BERT_POLICY_HEAD</key>
        <string>1</string>
        <!-- Development-only Jev review bridge. Without the bridge, Jev
             cannot return an explicit allow and review decisions fail closed. -->
        <key>ARMOR_JEV_REVIEW_ENABLED</key>
        <string>1</string>
        <key>ARMOR_JEV_REVIEW_URL</key>
        <string>http://127.0.0.1:8762/review</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/harshilbuch/Armor/armor_server.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/harshilbuch/Armor/armor_server.log</string>
</dict>
</plist>
